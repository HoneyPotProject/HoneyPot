# Copy this file to .env and fill in your values.

# API key for the management dashboard (required).
API_KEY=change-me-before-deployment

# SQLite database file location.
DATABASE_URL=sqlite+aiosqlite:///./data/database/honeypot.db

# Port for the decoy HTTP honeypot listener.
HONEYPOT_PORT=8080

# Port for the FastAPI management API.
MANAGEMENT_PORT=8000

# Comma-separated origins allowed by CORS (browser access to the API).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum events held in the in-memory queue before dropping starts.
EVENT_QUEUE_SIZE=1000

# Python logging level.
LOG_LEVEL=INFO
